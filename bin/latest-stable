#!/usr/bin/env bash

set -euo pipefail

current_script_path=${BASH_SOURCE[0]}
plugin_dir=$(dirname "$(dirname "$current_script_path")")

# shellcheck source=./lib/utils.bash
. "${plugin_dir}/lib/utils.bash"

query="${1:-}"

# Only x.y.z versions are stable; anything with a suffix (alpha, beta, ...) is not.
# A query such as "3" or "3.8" matches whole version components, so "3.1" does not match "3.10.0".
latest_stable_matching() {
	local pattern="^${query//./\\.}(\.|\$)"
	[ -n "$query" ] || pattern="."

	list_all_versions |
		grep -E '^[0-9]+\.[0-9]+\.[0-9]+$' |
		grep -E "$pattern" |
		sort_versions | tail -n1 || true
}

version=
if [ -z "$query" ]; then
	curl_opts=(-sI)

	if [ -n "${GITHUB_API_TOKEN:-}" ]; then
		curl_opts=("${curl_opts[@]}" -H "Authorization: token $GITHUB_API_TOKEN")
	fi

	# curl of REPO/releases/latest is expected to be a 302 to another URL
	# when no releases redirect_url="REPO/releases"
	# when there are releases redirect_url="REPO/releases/tag/v<VERSION>"
	# GitHub never marks a prerelease as the latest release.
	redirect_url=$(curl "${curl_opts[@]}" "$GH_REPO/releases/latest" | sed -n -e "s|^location: *||p" | sed -n -e "s|\r||p")
	printf "redirect url: %s\n" "$redirect_url" >&2
	if [[ "$redirect_url" != "$GH_REPO/releases" ]]; then
		version="$(printf "%s\n" "$redirect_url" | sed 's|.*/tag/v\{0,1\}||')"
	fi
fi

# A query was given, or the repository has no releases.
[ -n "$version" ] || version="$(latest_stable_matching)"

[ -n "$version" ] || fail "No stable version found matching '${query}'"

printf "%s\n" "$version"
